{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": ["${authors}"],
  "icon": "assets/${id}/icon.png",
  "contact": {
    "issues": "${issueUrl}"
  },
  "license": "${license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "${group}.betteritemoverlay.BetterItemOverlay"
    ],
    "modmenu": [
      "${group}.betteritemoverlay.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "${id}.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "*",
    "${fabricId}": ">=${fabricVersion}",
    "minecraft": ">=${minecraftVersion}",
    "shwgconfig": "*"
  }
}
